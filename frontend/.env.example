# Ethereum RPC URLs (server-side only, used in API routes)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Enderecos dos contratos (deployments/*.json apos deploy — nunca hardcoded)
OPTIMIZER_ROUTER_ADDRESS=0x...
OPTIMIZER_HOOK_ADDRESS=0x...
GENESIS_KEY_ADDRESS=0x...
STANDARD_TOKEN_ADDRESS=0x...
WETH_ADDRESS=0x...
IMD_TOKEN_ADDRESS=0x...

# Pools / venues
NATIVE_POOL_ADDRESS=0x...
HOOK_POOL_ADDRESS=0x...
POOL_MANAGER_ADDRESS=0x...
MIGRATION_ROUTER_ADDRESS=0x...

# Venues de arbitrage (executeCustomArbitrage: venueBuy / venueSell)
ARB_VENUE_BUY_ADDRESS=0x...
ARB_VENUE_SELL_ADDRESS=0x...

# Chain do frontend: 11155111 = Sepolia | 1 = mainnet
CHAIN_ID=11155111

# Rede-alvo da camada central de deployments (lib/deployments.ts)
# sepolia (default) | mainnet
NEXT_PUBLIC_ACTIVE_NETWORK=sepolia

# Fase do lançamento na Mainnet: premint (só Swap+Stake+Dashboard) | mint (tudo)
NEXT_PUBLIC_MAINNET_PHASE=premint
